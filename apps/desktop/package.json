{
  "name": "@hs/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "HealthSuite desktop shell (Electron)",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/main.cjs && esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "dev": "npm run build && wait-on http://127.0.0.1:5173 && cross-env HS_DEV_URL=http://127.0.0.1:5173 electron .",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  }
}
